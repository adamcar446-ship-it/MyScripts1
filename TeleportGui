local activeCategory = "LOCATIONS"
local function clearButtons()
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
end

local function render()
    clearButtons()
    local data = {}
    for _, category in ipairs(Categories) do
        if category.Name == activeCategory then data = category.Data break end
    end
    local names = {}
    for name in pairs(data) do
        if string.find(string.lower(name), string.lower(search.Text), 1, true) then
            table.insert(names, name)
        end
    end
    table.sort(names)
    for i, name in ipairs(names) do
        local button = Instance.new("TextButton")
        button.Name = name
        button.Size = UDim2.new(1, -4, 0, 35)
        button.LayoutOrder = i
        button.BackgroundColor3 = Color3.fromRGB(75, 55, 145)
        button.Text = "  " .. name
        button.TextColor3 = Color3.new(1, 1, 1)
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.Font = Enum.Font.GothamSemibold
        button.TextSize = 13
        button.Parent = scroll
        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
        button.MouseButton1Click:Connect(function()
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then root.CFrame = data[name] end
        end)
    end
end

for _, category in ipairs(Categories) do
    local tab = Instance.new("TextButton")
    tab.Size = UDim2.new(1/3, -5, 1, 0)
    tab.BackgroundColor3 = category.Name == activeCategory and Color3.fromRGB(115, 80, 210) or Color3.fromRGB(43, 43, 58)
    tab.Text = category.Name
    tab.TextColor3 = Color3.new(1, 1, 1)
    tab.Font = Enum.Font.GothamBold
    tab.TextSize = 11
    tab.Parent = tabs
    Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 6)
    tab.MouseButton1Click:Connect(function()
        activeCategory = category.Name
        for _, sibling in ipairs(tabs:GetChildren()) do
            if sibling:IsA("TextButton") then
                sibling.BackgroundColor3 = sibling.Text == activeCategory and Color3.fromRGB(115, 80, 210) or Color3.fromRGB(43, 43, 58)
            end
        end
        render()
    end)
end
