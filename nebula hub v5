	t1.ZIndex, t2.ZIndex = 302, 302
	tw(card, 0.35, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	local kids = {}
	for _, c in ipairs(notifHolder:GetChildren()) do if c:IsA("Frame") then kids[#kids + 1] = c end end
	if #kids > 5 then kids[1]:Destroy() end
	task.delay(Settings.notifyTime, function()
		if card.Parent then
			tw(card, 0.3, { Position = UDim2.new(1, 40, 0, 0) })
			task.wait(0.32)
			if wrap.Parent then wrap:Destroy() end
		end
	end)
end

