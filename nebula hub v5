local Features, nameSet = {}, {}
local function F(cat, name, desc, kind, fn, key, label)
	if nameSet[name] then
		local n = 2
		while nameSet[name .. " #" .. n] do n += 1 end
		name = name .. " #" .. n
	end
	nameSet[name] = true
	Features[#Features + 1] = { cat = cat, name = name, desc = desc, kind = kind, fn = fn, key = key, label = label, lname = name:lower(), ldesc = desc:lower() }
end
local function T(cat, name, desc, key) F(cat, name, desc, "toggle", nil, key) end
local function A(cat, name, desc, fn, label) F(cat, name, desc, "action", fn, nil, label) end
local function fam(cat, name, desc, from, to, step, fn, label)
	local count = math.floor((to - from) / step + 1e-6)
	for i = 0, count do
		local v = from + i * step
		local sv = n2s(math.floor(v * 1000 + 0.5) / 1000)
		A(cat, name:format(sv), desc:format(sv), function() fn(v) end, label)
	end
end
local function openB() showPage("Builder") end
local function toolMode(m) B.mode = m B.active = true if builderRefresh then builderRefresh() end openB() end

