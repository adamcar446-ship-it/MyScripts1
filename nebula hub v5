local function tw(inst, t, props, style, dir)
	if not Settings.anim then
		for k, v in pairs(props) do inst[k] = v end
		return nil
	end
	local tr = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tr:Play()
	return tr
end
local function mk(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function corner(i, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, i) end
local function stroke(i, color, th, tr) return mk("UIStroke", { Color = color or Theme.accent, Thickness = th or 1, Transparency = tr or 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i) end
local LO = 0
local function nextLO() LO += 1 return LO end
local function lbl(parent, text, size, pos, o)
	o = o or {}
	return mk("TextLabel", {
		BackgroundTransparency = 1, Text = text, Size = size, Position = pos or UDim2.new(),
		TextColor3 = o.color or Theme.text, Font = o.font or Enum.Font.Gotham, TextSize = o.ts or 13,
		TextXAlignment = o.ax or Enum.TextXAlignment.Left, TextYAlignment = o.ay or Enum.TextYAlignment.Center,
		TextTruncate = o.trunc and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
		RichText = o.rich or false, TextWrapped = o.wrap or false,
	}, parent)
end
local function setBase(b, c) b:SetAttribute("Base", c) b.BackgroundColor3 = c end
local function btn(parent, text, size, pos, cb, o)
	o = o or {}
	local b = mk("TextButton", {
		AutoButtonColor = false, Text = text, Size = size, Position = pos or UDim2.new(),
		TextColor3 = o.color or Theme.text, Font = Enum.Font.GothamMedium, TextSize = o.ts or 13, BorderSizePixel = 0,
	}, parent)
	corner(b, o.r or 8)
	if o.accent then bindAccent(b, "BackgroundColor3") else setBase(b, o.bg or Theme.panel2) end
	b.MouseEnter:Connect(function()
		local base = b:GetAttribute("Base") or Theme.panel2
		tw(b, 0.12, { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.14) })
	end)
	b.MouseLeave:Connect(function()
		tw(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base") or Theme.panel2 })
	end)
	if cb then b.Activated:Connect(function() cb() end) end
	return b
end
local function listFrame(parent)
	local sf = mk("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	bindAccent(sf, "ScrollBarImageColor3")
	mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
	return sf
end
local function rowFrame(parent, h)
	local f = mk("Frame", { Size = UDim2.new(1, -8, 0, h or 34), BackgroundColor3 = Theme.panel, BorderSizePixel = 0, LayoutOrder = nextLO() }, parent)
	corner(f, 8)
	return f
end
local function section(parent, text)
	local l = lbl(parent, string.upper(text), UDim2.new(1, -8, 0, 22), nil, { font = Enum.Font.GothamBold, ts = 11 })
	bindAccent(l, "TextColor3")
	l.LayoutOrder = nextLO()
	return l
end
local function rowOf(parent, items, h)
	local r = mk("Frame", { Size = UDim2.new(1, -8, 0, h or 32), BackgroundTransparency = 1, LayoutOrder = nextLO() }, parent)
	local n, btns = #items, {}
	for i, it in ipairs(items) do
		btns[i] = btn(r, it[1], UDim2.new(1 / n, -4, 1, 0), UDim2.new((i - 1) / n, 2, 0, 0), it[2])
	end
	return r, btns
end
local function stepper(parent, text, get, dec, inc)
	local r = rowFrame(parent, 36)
	lbl(r, text, UDim2.new(0.5, 0, 1, 0), UDim2.new(0, 10, 0, 0), { font = Enum.Font.GothamMedium })
	local val = lbl(r, "", UDim2.new(0, 98, 1, 0), UDim2.new(1, -144, 0, 0), { ax = Enum.TextXAlignment.Center, font = Enum.Font.GothamBold })
	bindAccent(val, "TextColor3")
	local function upd() val.Text = tostring(get()) end
	btn(r, "–", UDim2.fromOffset(30, 26), UDim2.new(1, -178, 0.5, -13), function() dec() upd() end)
	btn(r, "+", UDim2.fromOffset(30, 26), UDim2.new(1, -40, 0.5, -13), function() inc() upd() end)
	upd()
	return upd
end
local function toggleRow(parent, text, get, set)
	local r = rowFrame(parent, 36)
	lbl(r, text, UDim2.new(0.6, 0, 1, 0), UDim2.new(0, 10, 0, 0), { font = Enum.Font.GothamMedium })
	local b
	local function upd()
		local on = get()
		b.Text = on and "ON" or "OFF"
		if on then
			b:SetAttribute("Base", Theme.accent) b.BackgroundColor3 = Theme.accent
		else
			setBase(b, Theme.panel2)
		end
	end
	b = btn(r, "", UDim2.fromOffset(70, 26), UDim2.new(1, -80, 0.5, -13), function() set(not get()) upd() end)
	upd()
	return upd
end

