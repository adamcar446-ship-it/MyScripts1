local Core, S, Toggles, Tickers = {}, {}, {}, {}
S.flySpeed, S.sprintMult, S.dash, S.spin, S.fling = 60, 1.8, 110, 12, 120
S.espColor, S.espFill, S.espNames = Color3.fromRGB(168, 85, 247), 0.6, true
S.blur, S.bloom, S.sat, S.contrast = 16, 1.5, 0, 0
S.hold = { up = false, down = false }
S.waypoints = {}
local defaultGravity = Workspace.Gravity
local function cam() return Workspace.CurrentCamera end
local function char() return player.Character end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function root() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end
do
	local h = hum()
	S.orig = { ws = h and h.WalkSpeed or 16, jp = h and h.JumpPower or 50, hip = h and h.HipHeight or 2, fov = cam() and cam().FieldOfView or 70 }
end

local function removeTicker(name)
	if Tickers[name] then Tickers[name]:Disconnect() Tickers[name] = nil end
end
local function addTicker(name, fn, phase)
	removeTicker(name)
	local ev = (phase == "Stepped") and RunService.Stepped or RunService.Heartbeat
	Tickers[name] = ev:Connect(fn)
end
local function defToggle(name, title, fn, respawn)
	Toggles[name] = { on = false, fn = fn, respawn = respawn, title = title }
end
local function setToggle(name, on)
	local t = Toggles[name]
	if not t then return false end
	if on == nil then on = not t.on end
	local ok, err = pcall(t.fn, on)
	if ok then
		t.on = on
		notify(t.title, on and "Enabled" or "Disabled", on and "ok" or "info")
		log(t.title .. (on and " enabled" or " disabled"), on and "ok" or "info")
	else
		t.on = false
		pcall(t.fn, false)
		notify(t.title, cleanErr(err), "error")
		log("[" .. t.title .. "] " .. cleanErr(err), "error")
	end
	refreshList()
	return t.on
end

-- Basic stats
function Core.setWS(v) S.ws = v local h = hum() if h then h.WalkSpeed = v end end
function Core.setJP(v) S.jp = v local h = hum() if h then h.UseJumpPower = true h.JumpPower = v end end
function Core.setHip(v) S.hip = v local h = hum() if h then h.HipHeight = v end end
function Core.setGravity(v) Workspace.Gravity = v end
function Core.setFOV(v) v = math.clamp(v, 1, 120) S.fov = v local c = cam() if c then c.FieldOfView = v end end
function Core.tp(cf) local r = root() if not r then fail("No character found.") end r.CFrame = cf end
function Core.dash()
	local r = root() if not r then fail("No character found.") end
	r.AssemblyLinearVelocity = r.CFrame.LookVector * S.dash + Vector3.new(0, 25, 0)
end
function Core.reset() local h = hum() if not h then fail("No character found.") end h.Health = 0 end
function Core.rejoin()
	local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player) end)
	if not ok then
		local ok2 = pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
		if not ok2 then fail("Rejoin is not available here (Studio / unpublished place).") end
	end
end
function Core.sit() local h = hum() if not h then fail("No character found.") end h.Sit = true end
function Core.emote(name)
	local h = hum() if not h then fail("No character found.") end
	local ok, res = pcall(h.PlayEmote, h, name)
	if ok and res then return end
	local a = char():FindFirstChild("Animate")
	local pe = a and a:FindFirstChild("PlayEmote")
	if pe then pe:Invoke(name) return end
	fail("Emotes need an R15 avatar or the default Animate script.")
end
function Core.animSpeed(v)
	local h = hum() local an = h and h:FindFirstChildOfClass("Animator")
	if not an then fail("No Animator found on your character.") end
	for _, t in ipairs(an:GetPlayingAnimationTracks()) do t:AdjustSpeed(v) end
end
function Core.scale(s)
	local h = hum() if not h then fail("No character found.") end
	local ok = false
	for _, n in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }) do
		local v = h:FindFirstChild(n)
		if v then v.Value = s ok = true end
	end
	if not ok then fail("Scaling needs an R15 character with scale values.") end
end
function Core.fling()
	local r = root() if not r then fail("No character found.") end
	r.AssemblyLinearVelocity = r.CFrame.LookVector * S.fling + Vector3.new(0, S.fling, 0)
	r.AssemblyAngularVelocity = Vector3.new(math.random(-40, 40), 60, math.random(-40, 40))
end
function Core.backflip()
	local r, h = root(), hum()
	if not r or not h then fail("No character found.") end
	r.AssemblyLinearVelocity = Vector3.new(0, 55, 0) - r.CFrame.LookVector * 12
	local t = 0
	addTicker("flip", function(dt)
		local rr = root()
		if not rr then removeTicker("flip") return end
		t += dt
		rr.CFrame = rr.CFrame * CFrame.Angles(-math.rad(360) * dt / 0.6, 0, 0)
		if t >= 0.6 then removeTicker("flip") end
	end)
end
function Core.charParts(fn)
	local c = char() if not c then fail("No character found.") end
	for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then fn(p) end end
end
function Core.bodyHue(h)
	local c = char() if not c then fail("No character found.") end
	local col = hueColor(h)
	local bc = c:FindFirstChildOfClass("BodyColors")
	if bc then
		bc.HeadColor3, bc.TorsoColor3, bc.LeftArmColor3, bc.RightArmColor3, bc.LeftLegColor3, bc.RightLegColor3 = col, col, col, col, col, col
	else
		Core.charParts(function(p) if p.Name ~= "HumanoidRootPart" then p.Color = col end end)
	end
end
function Core.bodyMat(name)
	Core.charParts(function(p) if p.Name ~= "HumanoidRootPart" then p.Material = Enum.Material[name] end end)
end

-- Players
local function others()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then t[#t + 1] = p end
	end
	return t
end
local function findPlayer(q)
	if not q then fail("Missing player name.") end
	q = q:lower()
	local best
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local n, d = p.Name:lower(), p.DisplayName:lower()
			if n == q or d == q then return p end
			if not best and (n:sub(1, #q) == q or d:sub(1, #q) == q) then best = p end
		end
	end
	if not best then fail("Player not found: " .. q) end
	return best
end
function Core.tpPlayer(p)
	local tr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not tr then fail(p.Name .. " has no character.") end
	Core.tp(tr.CFrame * CFrame.new(0, 0, 3))
end
function Core.bring(p)
	local r = root()
	local tr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not r or not tr then fail("Character missing.") end
	tr.CFrame = r.CFrame * CFrame.new(0, 0, -4)
end
function Core.pick(mode)
	local list, r = others(), root()
	if #list == 0 then fail("No other players with characters.") end
	if mode == "random" then return list[math.random(#list)] end
	if not r then fail("No character found.") end
	table.sort(list, function(a, b)
		return (a.Character.HumanoidRootPart.Position - r.Position).Magnitude < (b.Character.HumanoidRootPart.Position - r.Position).Magnitude
	end)
	return mode == "nearest" and list[1] or list[#list]
end
function Core.info(p)
	p = p or player
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	local pos = r and string.format("%d, %d, %d", r.Position.X, r.Position.Y, r.Position.Z) or "n/a"
