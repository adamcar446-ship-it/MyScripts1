local Cmds, CmdList = {}, {}
local function cmd(name, usage, desc, fn, aliases)
	local c = { name = name, usage = usage, desc = desc, fn = fn }
	Cmds[name] = c
	for _, a in ipairs(aliases or {}) do Cmds[a] = c end
	CmdList[#CmdList + 1] = c
end
local function num(a, default, mn, mx)
	local n = tonumber(a)
	if not n then
		if default then return default end
		fail("Expected a number.")
	end
	if mn then n = math.max(mn, n) end
	if mx then n = math.min(mx, n) end
	return n
end
local function runCommand(line)
	line = line:match("^%s*(.-)%s*$")
	line = line:gsub("^[/;:]", "")
	if line == "" then return true end
	local parts = {}
	for w in line:gmatch("%S+") do parts[#parts + 1] = w end
	local name = table.remove(parts, 1):lower()
	local c = Cmds[name]
	if not c then return false, "Unknown command '" .. name .. "'. Type 'help'." end
	local ok, res = pcall(c.fn, parts)
	if ok then return true, res end
	return false, cleanErr(res)
end

cmd("help", "help [command]", "List commands or show one command's usage", function(a)
	if a[1] then
		local c = Cmds[a[1]:lower()]
		if not c then fail("Unknown command.") end
		return c.usage .. "  -  " .. c.desc
	end
	for _, c in ipairs(CmdList) do log(string.format("  %-24s %s", c.usage, c.desc), "info") end
	showPage("Console")
	return #CmdList .. " commands listed above."
end, { "?", "cmds", "commands" })
