track(UIS.InputBegan:Connect(function(input, gpe)
	if capture then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Settings[capture.field] = input.KeyCode.Name
			capture.btn.Text = input.KeyCode.Name
			capture = nil
		end
		return
	end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if cmdBox:IsFocused() then
			if input.KeyCode == Enum.KeyCode.Up and #CmdHistory > 0 then
				histIdx = math.max(1, histIdx - 1)
				cmdBox.Text = CmdHistory[histIdx]
				cmdBox.CursorPosition = #cmdBox.Text + 1
			elseif input.KeyCode == Enum.KeyCode.Down and #CmdHistory > 0 then
				histIdx = math.min(#CmdHistory + 1, histIdx + 1)
				cmdBox.Text = CmdHistory[histIdx] or ""
				cmdBox.CursorPosition = #cmdBox.Text + 1
			end
			return
		end
		if gpe then return end
		local k = input.KeyCode.Name
		if k == Settings.keyToggle then toggleWindow()
		elseif k == Settings.keyFly then setToggle("fly")
		elseif k == Settings.keyDash then local ok, e = pcall(Core.dash) if not ok then notify("Dash", cleanErr(e), "error") end
		elseif k == Settings.keyNoclip then setToggle("noclip")
		elseif k == "LeftShift" and Toggles.sprint.on then
			local h = hum() if h then h.WalkSpeed = (S.ws or S.orig.ws) * S.sprintMult end
		end
	elseif (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not gpe and B.active then
		worldClick(input)
	end
end))

----------------------------------------------------------------------
-- SIMULATOR INTERPRETER
----------------------------------------------------------------------
local function unq(s) return s:match('^"(.*)"$') or s:match("^'(.*)'$") or s end
runSim = function(src)
	local handlers = { WalkSpeed = Core.setWS, JumpPower = Core.setJP, HipHeight = Core.setHip, Gravity = Core.setGravity, FieldOfView = Core.setFOV }
	for rawLine in (src .. "\n"):gmatch("(.-)\r?\n") do
		local line = rawLine:match("^%s*(.-)%s*$")
		if line ~= "" and line:sub(1, 2) ~= "--" then
			local pr = line:match("^print%s*%((.*)%)%s*$")
			local wr = line:match("^warn%s*%((.*)%)%s*$")
			if pr then
				log(unq(pr), "info")
			elseif wr then
				log(unq(wr), "warn")
			elseif line:match("^task%.wait") or line:match("^wait") then
				local d = tonumber(line:match("%(%s*([%d%.]+)%s*%)")) or 0.1
				task.wait(math.clamp(d, 0, 3))
			elseif line:match("^loadstring") or line:match("^require") then
				log("Simulator: '" .. line:match("^%w+") .. "' is not available (no real code execution).", "warn")
			else
				local k, v = line:match("%.(%a+)%s*=%s*(%-?[%d%.]+)%s*$")
				if k and handlers[k] then
					local ok, e = pcall(handlers[k], tonumber(v))
					if ok then log(k .. " = " .. v, "ok") else log(cleanErr(e), "error") end
				else
					local ok, res = runCommand(line)
					if ok then if res then log(res, "ok") end
					else log((res:find("^Unknown command") and ("Unsupported statement in simulator: " .. line) or res), "error") end
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- SHUTDOWN / CLEANUP
----------------------------------------------------------------------
local closed = false
function Core.shutdown()
	if closed then return end
	closed = true
	for _, t in pairs(Toggles) do
		if t.on then pcall(t.fn, false) t.on = false end
	end
	for n in pairs(Tickers) do removeTicker(n) end
	Workspace.Gravity = defaultGravity
	local h = hum()
	if h then
		h.WalkSpeed, h.HipHeight = S.orig.ws, S.orig.hip
		h.UseJumpPower = true h.JumpPower = S.orig.jp h.CameraOffset = Vector3.zero
	end
	if cam() then cam().FieldOfView = S.orig.fov end
	for _, n in ipairs({ "NebulaV7_Blur", "NebulaV7_Bloom", "NebulaV7_CC", "NebulaV7_Atmo" }) do
		local o = Lighting:FindFirstChild(n) if o then o:Destroy() end
	end
	if airPart then airPart:Destroy() end
	if B.hl then B.hl:Destroy() end
	espClear()
	for _, c in ipairs(conns) do c:Disconnect() end
	table.clear(conns)
	for _, t in ipairs(orbTweens) do t:Cancel() end
	gui:Destroy()
	_G.__NebulaV7 = nil
end
_G.__NebulaV7 = { Destroy = Core.shutdown }
gui.Destroying:Connect(function() if not closed then Core.shutdown() end end)

