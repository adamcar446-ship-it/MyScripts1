function Core.execute(src)
	src = src or editor.Text
	if src:match("^%s*$") then notify("Executor", "The script is empty.", "warn") return end
	local function go()
		addHistory(src)
		log("▶ Executing script (" .. #src .. " chars)...", "info")
		edStatus.Text = "Executed at " .. os.date("%H:%M:%S")
		task.spawn(function()
			local ok, e = pcall(runSim, src)
			if ok then log("✔ Script finished.", "ok") notify("Executor", "Script executed (simulated).", "ok")
			else log(cleanErr(e), "error") end
		end)
	end
	if injected then go() else playInjection(go) end
end
