    -----------------------------------------------------------------------------------
    INSTALL : put this file in a LocalScript inside StarterPlayer > StarterPlayerScripts
              (or StarterGui). It is ONE self-contained script. No modules needed.
    NOTE    : This is a simulator UI. "Execute" runs a safe built-in simulator interpreter
              (commands, print/warn, a few property assignments) - it never runs arbitrary code.
    SETTINGS: saved to a player attribute (lasts for the session). Add a DataStore if you
              want cross-session saves.

    OPTIONAL - SERVER-AUTHORIZED BUILDING
    If a RemoteFunction named "NebulaBuildRemote" exists in ReplicatedStorage, every build action
    (create / edit / delete / restore) is sent to the server instead of being built locally.
    Paste this into a Script in ServerScriptService to enable it:

    --[==[
    local RS=game:GetService("ReplicatedStorage")
    local WS=game:GetService("Workspace")
    local remote=Instance.new("RemoteFunction") remote.Name="NebulaBuildRemote" remote.Parent=RS
    local trash=Instance.new("Folder") trash.Name="NebulaTrash" trash.Parent=RS
    local CLASSES={Part=true,WedgePart=true,CornerWedgePart=true}
    local PROPS={Size="Vector3",CFrame="CFrame",Color="Color3",Material="EnumItem",Transparency="number",
        Reflectance="number",Anchored="boolean",CanCollide="boolean",Name="string",Shape="EnumItem"}
    local function folderFor(plr)
        local n="NebulaBuild_"..plr.UserId
        local f=WS:FindFirstChild(n)
        if not f then f=Instance.new("Folder") f.Name=n f.Parent=WS end
        return f
    end
    local function apply(part,props)
        for k,v in pairs(props) do
            local t=PROPS[k]
            if t and typeof(v)==t then
                if k=="Size" then v=Vector3.new(math.clamp(v.X,0.2,512),math.clamp(v.Y,0.2,512),math.clamp(v.Z,0.2,512)) end
                if k=="Name" then v=string.sub(v,1,40) end
                if not (k=="Shape" and not part:IsA("Part")) then pcall(function() part[k]=v end) end
            end
        end
    end
    remote.OnServerInvoke=function(plr,action,a,b)
        local folder=folderFor(plr)
        if action=="create" then
            if type(a)~="string" or not CLASSES[a] or type(b)~="table" then return nil end
            if #folder:GetChildren()>=500 then return nil end
            local p=Instance.new(a) p.Anchored=true apply(p,b)
            p:SetAttribute("Owner",plr.UserId) p.Parent=folder
            return p
        elseif action=="set" then
            if typeof(a)~="Instance" or a:GetAttribute("Owner")~=plr.UserId or type(b)~="table" then return nil end
            apply(a,b) return true
        elseif action=="parent" then
            if typeof(a)~="Instance" or a:GetAttribute("Owner")~=plr.UserId then return nil end
            a.Parent=(b==true) and trash or folder
            return true
        end
    end
    ]==]
]]

