----------------------------------------------------------------------
-- BUILDER CORE (FE building toolbox)
----------------------------------------------------------------------
local MATS = { "Plastic", "SmoothPlastic", "Neon", "Wood", "WoodPlanks", "Metal", "DiamondPlate", "Foil", "Glass", "Ice", "Brick", "Concrete", "Granite", "Marble", "Slate", "Sand", "Grass", "Fabric", "Cobblestone", "Pebble" }
local SHAPES = {
	{ "Block", "Part", Enum.PartType.Block }, { "Ball", "Part", Enum.PartType.Ball }, { "Cylinder", "Part", Enum.PartType.Cylinder },
	{ "Wedge", "WedgePart" }, { "Corner Wedge", "CornerWedgePart" },
}
local SNAPS = { 0, 0.25, 0.5, 1, 2, 4, 5, 8 }
local B = { sel = nil, undo = {}, redo = {}, snapIdx = 4, hue = 270, color = Color3.fromHSV(270 / 360, 0.85, 1), matIdx = 2, shapeIdx = 1, size = Vector3.new(4, 1, 4), mode = "Place", step = 1, rot = 15, templates = {}, tplIdx = 1, active = false }
local function snapAmount() return SNAPS[B.snapIdx] end
local function snapV(v) local g = snapAmount() if g > 0 then return math.floor(v / g + 0.5) * g end return v end
local function snapVec(v) return Vector3.new(snapV(v.X), snapV(v.Y), snapV(v.Z)) end
local function buildFolder()
	local n = "NebulaBuild_" .. player.UserId
	local f = Workspace:FindFirstChild(n)
	if not f then f = Instance.new("Folder") f.Name = n f.Parent = Workspace end
	return f
end
local function trashFolder()
	local f = ReplicatedStorage:FindFirstChild("NebulaTrash")
	if not f then f = Instance.new("Folder") f.Name = "NebulaTrash" f.Parent = ReplicatedStorage end
	return f
end
local function remote()
	local r = ReplicatedStorage:FindFirstChild("NebulaBuildRemote")
	return (r and r:IsA("RemoteFunction")) and r or nil
end
local function bCreate(class, props)
	local rf = remote()
	if rf then
		local ok, res = pcall(rf.InvokeServer, rf, "create", class, props)
		if ok and typeof(res) == "Instance" then return res end
		fail(ok and "The server refused the build request." or "Server build error.")
	end
	if #buildFolder():GetChildren() >= 500 then fail("Part limit (500) reached.") end
	local p = Instance.new(class)
	p.Anchored = true p.TopSurface = Enum.SurfaceType.Smooth p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do p[k] = v end
	p:SetAttribute("Owner", player.UserId)
	p.Parent = buildFolder()
	return p
end
local function bSet(part, props)
	local rf = remote()
	if rf then
		local ok = pcall(rf.InvokeServer, rf, "set", part, props)
		if not ok then fail("Server build error.") end
		return
	end
	for k, v in pairs(props) do part[k] = v end
end
local function bTrash(part, trashed)
	local rf = remote()
	if rf then
		local ok = pcall(rf.InvokeServer, rf, "parent", part, trashed)
		if not ok then fail("Server build error.") end
		return
	end
	part.Parent = trashed and trashFolder() or buildFolder()
end
local function record(u, r)
	if B.collect then B.collect[#B.collect + 1] = { u = u, r = r } return end
	B.undo[#B.undo + 1] = { u = u, r = r }
	if #B.undo > 100 then table.remove(B.undo, 1) end
	table.clear(B.redo)
end
local function group(fn)
	B.collect = {}
	local ok, err = pcall(fn)
	local list = B.collect
	B.collect = nil
	if #list > 0 then
		record(function() for i = #list, 1, -1 do list[i].u() end end, function() for i = 1, #list do list[i].r() end end)
	end
	if not ok then fail(cleanErr(err)) end
end
B.hl = mk("Highlight", { FillColor = Theme.accent, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.7, Enabled = false, Name = "NebulaSel" }, Workspace)
local function selectPart(p)
	B.sel = p
	B.hl.Adornee = p
	B.hl.Enabled = p ~= nil
	if builderRefresh then builderRefresh() end
end
local function shapeIdxOf(p)
	if p:IsA("WedgePart") then return 4 end
	if p:IsA("CornerWedgePart") then return 5 end
	if p:IsA("Part") then
		if p.Shape == Enum.PartType.Ball then return 2 elseif p.Shape == Enum.PartType.Cylinder then return 3 end
	end
	return 1
end
local function newPart(cf, size, opts)
	opts = opts or {}
	local shp = SHAPES[opts.shape or B.shapeIdx]
	local props = { Size = size or B.size, CFrame = cf, Color = opts.color or B.color, Material = opts.mat or Enum.Material[MATS[B.matIdx]] }
	if shp[3] then props.Shape = shp[3] end
	local p = bCreate(shp[2], props)
	record(function() if B.sel == p then selectPart(nil) end bTrash(p, true) end, function() bTrash(p, false) end)
	selectPart(p)
	return p
end
local function modify(part, props)
	if not part or not part.Parent then fail("Select a part first.") end
	local old = {}
	for k in pairs(props) do old[k] = part[k] end
	bSet(part, props)
	record(function() bSet(part, old) end, function() bSet(part, props) end)
end
local function needSel() if not B.sel or not B.sel.Parent then fail("Select a part first.") end return B.sel end
local Bld = {}
function Bld.front(size)
	local r = root()
	if not r then return Vector3.new(0, size.Y / 2, 0) end
	local base = (r.CFrame * CFrame.new(0, 0, -(math.max(size.X, size.Z) / 2 + 6))).Position
	return snapVec(Vector3.new(base.X, r.Position.Y - 3 + size.Y / 2, base.Z))
end
function Bld.spawn(size, opts)
	size = size or B.size
	return newPart(CFrame.new(Bld.front(size)), size, opts)
end
function Bld.delete()
	local p = needSel()
	bTrash(p, true)
	selectPart(nil)
	record(function() bTrash(p, false) end, function() if B.sel == p then selectPart(nil) end bTrash(p, true) end)
end
function Bld.duplicate()
	local p = needSel()
	newPart(p.CFrame + Vector3.new(p.Size.X + 0.5, 0, 0), p.Size, { shape = shapeIdxOf(p), color = p.Color, mat = p.Material })
end
function Bld.move(axis, sign)
	local p = needSel()
	local cf = p.CFrame + axis * sign * B.step
	local pos = snapVec(cf.Position)
	modify(p, { CFrame = CFrame.new(pos) * (cf - cf.Position) })
end
function Bld.resize(axis, sign)
	local p = needSel()
	local s = p.Size + axis * sign * B.step
	modify(p, { Size = Vector3.new(math.clamp(s.X, 0.2, 512), math.clamp(s.Y, 0.2, 512), math.clamp(s.Z, 0.2, 512)) })
end
function Bld.rotate(axis, sign)
	local p = needSel()
	modify(p, { CFrame = p.CFrame * CFrame.fromAxisAngle(axis, math.rad(B.rot) * sign) })
end
function Bld.paint(p)
	p = p or needSel()
	modify(p, { Color = B.color, Material = Enum.Material[MATS[B.matIdx]] })
end
function Bld.undo() local a = table.remove(B.undo) if not a then fail("Nothing to undo.") end a.u() B.redo[#B.redo + 1] = a end
function Bld.redo() local a = table.remove(B.redo) if not a then fail("Nothing to redo.") end a.r() B.undo[#B.undo + 1] = a end
function Bld.clearAll()
	local list = buildFolder():GetChildren()
	if #list == 0 then fail("Nothing to clear.") end
	selectPart(nil)
	group(function()
		for _, p in ipairs(list) do
			bTrash(p, true)
			record(function() bTrash(p, false) end, function() bTrash(p, true) end)
		end
	end)
end
function Bld.saveTemplate()
	local parts = buildFolder():GetChildren()
	if #parts == 0 then fail("Build something first.") end
	local origin = parts[1].CFrame
	local t = { name = "Model " .. (#B.templates + 1), items = {} }
	for i, p in ipairs(parts) do
		if i > 100 then break end
		t.items[#t.items + 1] = { shape = shapeIdxOf(p), size = p.Size, rel = origin:ToObjectSpace(p.CFrame), color = p.Color, mat = p.Material }
	end
	B.templates[#B.templates + 1] = t
	B.tplIdx = #B.templates
end
function Bld.spawnTemplate()
	local t = B.templates[B.tplIdx]
	if not t then fail("No saved models yet - press Save Model first.") end
	local base = CFrame.new(Bld.front(Vector3.new(8, 4, 8)) + Vector3.new(0, 2, 0))
	group(function()
		for _, it in ipairs(t.items) do newPart(base * it.rel, it.size, { shape = it.shape, color = it.color, mat = it.mat }) end
	end)
end
local function worldRay(pos)
	local c = cam()
	if not c then return nil end
	local ray = c:ScreenPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	if char() then ex[#ex + 1] = char() end
	if airPart then ex[#ex + 1] = airPart end
	params.FilterDescendantsInstances = ex
	return Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
end
local function worldClick(input)
	local hit = worldRay(input.Position)
	if not hit then return end
	local inst = hit.Instance
	local mine = inst:IsDescendantOf(buildFolder())
	local function go()
		local m = B.mode
		if m == "Place" then
			local pos = snapVec(hit.Position + hit.Normal * (B.size.Y / 2))
			newPart(CFrame.new(pos), B.size)
		elseif m == "Select" then
			selectPart(mine and inst or nil)
		elseif m == "Move" then
			local p = needSel()
			modify(p, { CFrame = CFrame.new(snapVec(hit.Position + hit.Normal * (p.Size.Y / 2))) * (p.CFrame - p.CFrame.Position) })
		elseif m == "Paint" then
			if mine then Bld.paint(inst) end
		elseif m == "Delete" then
			if mine then selectPart(inst) Bld.delete() end
		elseif m == "Copy" then
			if mine then selectPart(inst) Bld.duplicate() end
		end
	end
	local ok, err = pcall(go)
	if not ok then notify("Builder", cleanErr(err), "error") end
	if builderRefresh then builderRefresh() end
end

