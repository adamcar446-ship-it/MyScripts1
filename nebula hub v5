local accentBound = {}
local function bindAccent(inst, prop)
	accentBound[#accentBound + 1] = { inst, prop }
	inst[prop] = Theme.accent
	if prop == "BackgroundColor3" then inst:SetAttribute("Base", Theme.accent) end
end
applyAccent = function()
	local a = ACCENTS[Settings.accent] or ACCENTS[1]
	Theme.accent = Color3.fromRGB(a[2], a[3], a[4])
	for i = #accentBound, 1, -1 do
		local e = accentBound[i]
		if e[1].Parent then
			e[1][e[2]] = Theme.accent
			if e[2] == "BackgroundColor3" then e[1]:SetAttribute("Base", Theme.accent) end
		else
			table.remove(accentBound, i)
		end
	end
end
