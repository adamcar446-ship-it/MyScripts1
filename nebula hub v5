local function updateSuggestions()
	for _, c in ipairs(sug:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
	local txt = cmdBox.Text:lower()
	local word = txt:match("^%s*([^%s]*)")
	if not word or word == "" then sug.Visible = false return end
	local list = {}
	if txt:match("^%s*%S+%s") then
		local c = Cmds[word]
		if c then list[1] = c end
	else
		for _, c in ipairs(CmdList) do if c.name:sub(1, #word) == word then list[#list + 1] = c end end
		if #list == 0 then for _, c in ipairs(CmdList) do if c.name:find(word, 1, true) then list[#list + 1] = c end end end
	end
	for i = 1, math.min(#list, 5) do
		local c = list[i]
		local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "  " .. c.usage .. "   — " .. c.desc, TextColor3 = Theme.text, Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = i, ZIndex = 41 }, sug)
		b.Activated:Connect(function() cmdBox.Text = c.name .. " " cmdBox:CaptureFocus() end)
	end
	sug.Size = UDim2.new(1, -SIDE - 24, 0, math.min(#list, 5) * 26)
	sug.Visible = #list > 0
end
